#!/system/bin/sh

# Setup Path
cd "$(dirname "$0")/.."
MODPATH=$(pwd)
BIN_DIR="$MODPATH/bin"
LIB_DIR="$MODPATH/lib"
VAR_DIR="$MODPATH/var"

# Configured Paths
NODE_BIN="$BIN_DIR/node"
APP_DIR="$VAR_DIR/app"
LOG_FILE="$VAR_DIR/log/node.log"
PID_FILE="$VAR_DIR/tmp/node.pid"

# Set Timezone
export TZ=$(getprop persist.sys.timezone)

# Auto Entry Point
if [ -f "$APP_DIR/index.js" ]; then
	APP_MAIN="$APP_DIR/index.js"
elif [ -f "$APP_DIR/main.js" ]; then
	APP_MAIN="$APP_DIR/main.js"
elif [ -f "$APP_DIR/app.js" ]; then
	APP_MAIN="$APP_DIR/app.js"
else
	APP_MAIN=""
fi

# Check Busybox
if [ -x "/data/adb/magisk/busybox" ]; then
	BUSYBOX="/data/adb/magisk/busybox"
elif [ -x "/data/adb/ksu/bin/busybox" ]; then
	BUSYBOX="/data/adb/ksu/bin/busybox"
elif [ -x "/data/adb/ap/bin/busybox" ]; then
	BUSYBOX="/data/adb/ap/bin/busybox"
elif [ -x "/system/xbin/busybox" ]; then
	BUSYBOX="/system/xbin/busybox"
else
	BUSYBOX=$(which busybox)
fi
SETUIDGID="$BUSYBOX setuidgid"

# Strict PID Check
check_pid_running() {
	if [ -f "$PID_FILE" ]; then
		local pid=$(cat "$PID_FILE" 2>/dev/null)
		if pgrep -f "node" | grep -q "^${pid}$" 2>/dev/null; then
			return 0
		fi
		rm -f "$PID_FILE"
	fi
	return 1
}

# Start Function
start_service() {
	mkdir -p "$VAR_DIR/log"
	mkdir -p "$VAR_DIR/tmp"

	if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE")" -gt 1048576 ]; then
		mv "$LOG_FILE" "${LOG_FILE}.bak"
	fi

	if check_pid_running; then
		echo "✅ Node.js Service is already RUNNING (PID: $(cat $PID_FILE))"
		echo "[INFO] Node.js Service is already running (PID: $(cat $PID_FILE))" >>"$LOG_FILE"
		exit 0
	fi

	if [ -z "$APP_MAIN" ] || [ ! -f "$APP_MAIN" ]; then
		echo "❌ ERROR: Entry file not found!"
		echo "[ERROR] Entry file (index.js/main.js/app.js) not found!" >>"$LOG_FILE"
		echo "[INFO] Hint: Make sure you put the script in folder: $APP_DIR" >>"$LOG_FILE"
		exit 1
	fi

	echo "🚀 Starting Node.js Service..."
	echo "[INFO] Starting Node.js Service..." >>"$LOG_FILE"

	ENV_FILE="$APP_DIR/.env"

	if [ -f "$ENV_FILE" ]; then
		NODE_ARGS="--env-file=$ENV_FILE"
		echo "[INFO] Using .env file at: $ENV_FILE" >>"$LOG_FILE"
	else
		NODE_ARGS=""
		echo "[WARN] No .env file found at: $ENV_FILE" >>"$LOG_FILE"
	fi

	# Supervisor loop: auto-restarts node 5s after a crash. The PID file
	# always holds the CURRENT node PID; removing it (via stop_service)
	# tells the loop to exit instead of restarting.
	: >"$PID_FILE"
	(
	while [ -f "$PID_FILE" ]; do
		$SETUIDGID 0:3003 env LD_LIBRARY_PATH=$LIB_DIR \
			$NODE_BIN $NODE_ARGS $APP_MAIN \
			>>"$LOG_FILE" 2>&1 &
		echo $! >"$PID_FILE"
		wait $!
		ecode=$?
		sleep 5
		if [ -f "$PID_FILE" ]; then
			echo "[WARN] Node.js exited (code $ecode). Restarting..." >>"$LOG_FILE"
		fi
	done
	) >>"$LOG_FILE" 2>&1 &
	sleep 2

	if check_pid_running; then
		local pid=$(cat "$PID_FILE")
		echo "✅ Service STARTED successfully (PID: $pid)"
		echo "[INFO] Service STARTED successfully (PID: $pid)" >>"$LOG_FILE"
		echo "[INFO] Running script: $APP_MAIN" >>"$LOG_FILE"
	else
		echo "❌ Service FAILED to start. Check details in: $LOG_FILE"
		echo "[ERROR] Service FAILED to start." >>"$LOG_FILE"
	fi
}

# Stop Function
stop_service() {
	if [ -f "$PID_FILE" ]; then
		local pid=$(cat "$PID_FILE")
		kill -9 $pid >/dev/null 2>&1
		rm -f "$PID_FILE"
		echo "✅ Node.js Service stopped"
		echo "[INFO] Node.js Service stopped." >>"$LOG_FILE"
	else
		pkill -f "nodejs/var/app/index.js" >/dev/null 2>&1
		echo "[INFO] Cleaned up node processes." >>"$LOG_FILE"
	fi
}

# Status Function
status_service() {
	if check_pid_running; then
		local pid=$(cat "$PID_FILE")

		echo "Node.js Service is RUNNING"
		echo "PID  : $pid"
		echo "APP  : $APP_MAIN"

		local ram_usage=$(grep "VmRSS" "/proc/$pid/status" 2>/dev/null | awk '{printf "%.1f MB", $2/1024}')

		if [ -z "$ram_usage" ]; then ram_usage="0 MB"; fi
		echo "RAM  : $ram_usage"

		local uptime=$(ps -o etime= -p $pid 2>/dev/null | xargs | awk -F'[-:]' '{
      if (NF == 4) print $1"d "$2"h "$3"m "$4"s"
      else if (NF == 3) print $1"h "$2"m "$3"s"
      else if (NF == 2) print $1"m "$2"s"
      else print "-"
    }')

		if [ -z "$uptime" ]; then uptime="-"; fi
		echo "TIME : $uptime"
	else
		echo "❌ Node.js Service is STOPPED"
		if [ -f "$PID_FILE" ]; then
			echo "   (Stale PID file found & cleaned)"
			rm -f "$PID_FILE"
		fi
	fi
}

# Argument Control
case "$1" in
-s | start) start_service ;;
-k | stop) stop_service ;;
-r | restart)
	stop_service
	sleep 1
	start_service
	;;
-t | status) status_service ;;
-v | version) env LD_LIBRARY_PATH=$LIB_DIR $NODE_BIN -v ;;
*)
	echo "Usage: $0 [option]"
	echo ""
	echo "Options:"
	echo "  -s, start    Start the service"
	echo "  -k, stop     Stop the service"
	echo "  -r, restart  Restart the service"
	echo "  -t, status   Check service status"
	echo "  -v, version  Show version info"
	;;
esac
